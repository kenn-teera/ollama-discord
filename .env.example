DISCORD_TOKEN=your-discord-token
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
SYSTEM_PROMPT=You are a helpful assistant in a Discord server. Keep answers concise.
# number of past messages kept per channel
HISTORY_LIMIT=10

# MCP search tool. Recommended: local SearXNG (no key; run ./searxng/setup.sh first):
# SEARXNG_URL=http://127.0.0.1:8888
# MCP_ENABLED=false   # turn tools off
# OLLAMA_NUM_CTX=8192   # context window (larger = more memory)
# OLLAMA_TEMPERATURE=0.8
# MAX_TOOL_ROUNDS=4
# OLLAMA_TOP_P=0.9
# OLLAMA_NUM_PREDICT=0       # max tokens per model call, 0 = no limit
# OLLAMA_KEEP_ALIVE=5m       # how long the model stays loaded after the last reply (-1 = forever)
# INJECT_DATE=true   # put today's date next to each question so the model doesn't guess the year
# OLLAMA_THINKING=false   # true = let thinking models (qwen3, deepseek-r1) reason first: slower, many more tokens
# HISTORY_SCOPE=user   # user = private per person (default), channel = shared by everyone in the channel
# Which MCP servers are on is chosen in the dashboard (see README); the lines above just set the first choice.

# Web dashboard (settings page). Local only by default.
# WEB_PORT=8787
# WEB_HOST=127.0.0.1        # anything other than localhost REQUIRES WEB_PASSWORD
# WEB_PASSWORD=choose-a-strong-password
