{
  "name": "ollama-discord",
  "version": "1.0.0",
  "description": "Discord bot powered by a local Ollama model (qwen2.5:3b)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "loadtest": "node --env-file=.env scripts/loadtest.js",
    "bot:start": "./bot.sh start",
    "bot:stop": "./bot.sh stop",
    "dev": "node --watch --env-file=.env src/index.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "discord.js": "^14.16.3"
  }
}
